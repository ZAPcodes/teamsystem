PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://user:password@cluster.example/perx
SESSION_SECRET=dev-session-secret-change-me
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Production frontend URL (Vercel) — used for CORS and email links
APP_URL=http://localhost:3000

# Optional on Render (auto-set as RENDER_EXTERNAL_URL). Override if using a custom domain.
# PUBLIC_URL=https://perx-api.onrender.com

# Comma-separated preview/staging frontends allowed by CORS
# CORS_ORIGINS=https://perx-git-main-yourteam.vercel.app

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=PerxBenefitsBot

# Set to true to use long-polling locally against a tunnel (default: webhook in production)
# TELEGRAM_USE_POLLING=false
